# Prevent directory browsingOptions -Indexes# Set default index filesDirectoryIndex index.php login.php<IfModule mod_rewrite.c>    RewriteEngine On    # Block direct access to components directory    RewriteRule ^components/ - [F,L]    # Block direct access to sensitive PHP files (but allow upload scripts)    RewriteCond %{REQUEST_FILENAME} \.php$# UPRAVENÝ ŘÁDEK:RewriteCond %{REQUEST_URI} !^/(index|login|logout|test|debug-ftp|hello|fb-test|fb_debug|basic-index|contest|contest-questions|contest-results)\.php$    RewriteCond %{REQUEST_URI} !^/(contest-handler|contest-answers-handler)\.php$    RewriteCond %{REQUEST_URI} !^/(upload-|publish-|delete-|edit-|add-|get-|manage-|save-|chunked-|serve-).*\.php$    RewriteRule ^(.*)$ /login.php [R=302,L]    # Block hidden directories    RewriteRule ^\.(.*)$ - [F,L]</IfModule># Block sensitive files<FilesMatch "\.(log|json|md|txt)$">    Order Deny,Allow    Deny from all</FilesMatch># Basic compression<IfModule mod_deflate.c>    AddOutputFilterByType DEFLATE text/css text/javascript application/javascript text/html</IfModule>	